# Public site URL, no trailing slash. Used for canonical links, Open Graph
# images and the sitemap. Leave blank until the domain is confirmed.
VITE_SITE_URL=

# How enquiries are delivered. Server-side only.
# log      — write JSON files to .enquiries/ (local development)
# resend   — send mail through Resend
# webhook  — POST the enquiry to WEBHOOK_URL
# Leave unset in production to refuse submissions instead of pretending they sent.
FORM_PROVIDER=log

# Directory for FORM_PROVIDER=log. Defaults to .enquiries
ENQUIRY_LOG_DIR=.enquiries

# Resend (https://resend.com). Required only when FORM_PROVIDER=resend.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Required only when FORM_PROVIDER=webhook.
# The endpoint receives a JSON enquiry. Keep the URL private.
WEBHOOK_URL=
WEBHOOK_SECRET=
